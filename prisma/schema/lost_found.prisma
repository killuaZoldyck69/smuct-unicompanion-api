// ==============================
// LOST & FOUND ENUMS
// ==============================

enum LostFoundType {
  LOST
  FOUND
}

enum LostFoundStatus {
  ACTIVE
  CLAIMED
  RESOLVED
  CLOSED
}

enum LostFoundClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum LostFoundCategory {
  BOOKS
  ELECTRONICS
  ID_CARD
  KEYS
  CLOTHING
  WALLET
  BAGS
  DOCUMENTS
  ACCESSORIES
  STATIONERY
  UMBRELLA
  BOTTLE
  OTHER
}

// ==============================
// LOST & FOUND MODULE
// ==============================

model LostFoundPost {
  id                   String            @id @default(uuid())
  authorId             String
  type                 LostFoundType
  title                String
  description          String?
  category             LostFoundCategory
  location             String?
  status               LostFoundStatus   @default(ACTIVE)
  images               String[]          @default([])
  verificationQuestion String?
  verificationAnswer   String?
  resolvedClaimId      String?
  idempotencyKey       String?
  isHiddenByModeration Boolean           @default(false)
  hiddenAt             DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  claims LostFoundClaim[]

  @@unique([authorId, idempotencyKey])
  @@index([authorId])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([authorId, status, createdAt(sort: Desc)])
  @@index([status, type])
  @@index([status, type, createdAt(sort: Desc)])
  @@index([category, status, createdAt(sort: Desc)])
  @@index([isHiddenByModeration, createdAt(sort: Desc)])
  @@index([isHiddenByModeration, status, createdAt(sort: Desc)])
  @@index([isHiddenByModeration, type, createdAt(sort: Desc)])
  @@index([isHiddenByModeration, type, status, createdAt(sort: Desc)])
  @@map("lost_found_post")
}

model LostFoundClaim {
  id           String               @id @default(uuid())
  postId       String
  claimantId   String
  status       LostFoundClaimStatus @default(PENDING)
  attemptCount Int                  @default(1)
  message      String
  answer       String?
  proofImage   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  post     LostFoundPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  claimant User          @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  @@unique([postId, claimantId])
  @@index([postId, status])
  @@index([claimantId])
  @@index([claimantId, status])
  @@index([proofImage])
  @@map("lost_found_claim")
}
