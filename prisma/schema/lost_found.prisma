// ==============================
// LOST & FOUND ENUMS
// ==============================

enum LostFoundType {
  LOST
  FOUND
}

enum LostFoundStatus {
  ACTIVE
  CLAIMED
  RESOLVED
  CLOSED
}

enum LostFoundClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum LostFoundCategory {
  BOOKS
  ELECTRONICS
  ID_CARD
  KEYS
  CLOTHING
  WALLET
  BAGS
  DOCUMENTS
  ACCESSORIES
  STATIONERY
  UMBRELLA
  BOTTLE
  OTHER
}

// ==============================
// LOST & FOUND MODULE
// ==============================

model LostFoundPost {
  id                   String            @id @default(uuid())
  authorId             String
  type                 LostFoundType
  title                String
  description          String?
  category             LostFoundCategory
  location             String?
  status               LostFoundStatus   @default(ACTIVE)
  images               String[]          @default([])
  verificationQuestion String?
  verificationAnswer   String?
  resolvedClaimId      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  claims LostFoundClaim[]

  @@index([authorId])
  @@index([status, type])
  @@map("lost_found_post")
}

model LostFoundClaim {
  id         String               @id @default(uuid())
  postId     String
  claimantId String
  status     LostFoundClaimStatus @default(PENDING)
  message    String
  answer     String?
  proofImage String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  post     LostFoundPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  claimant User          @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  @@unique([postId, claimantId])
  @@index([postId, status])
  @@index([claimantId])
  @@map("lost_found_claim")
}

