// ==============================
// MEME ENUMS
// ==============================

enum MemeReactionType {
  LIKE
  DISLIKE
}

// ==============================
// MEME MODULE
// ==============================

model Meme {
  id                   String         @id @default(uuid())
  authorId             String
  caption              String?
  imageUrl             String
  idempotencyKey       String?
  likesCount           Int            @default(0)
  dislikesCount        Int            @default(0)
  popularityScore      Int            @default(0)
  isHiddenByModeration Boolean        @default(false)
  hiddenAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions MemeReaction[]

  @@unique([authorId, idempotencyKey])
  @@index([imageUrl])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([isHiddenByModeration, createdAt(sort: Desc)])
  @@index([isHiddenByModeration, popularityScore(sort: Desc), createdAt(sort: Desc)])
  @@map("meme")
}

model MemeReaction {
  id        String           @id @default(uuid())
  memeId    String
  userId    String
  type      MemeReactionType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  meme      Meme             @relation(fields: [memeId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memeId, userId])
  @@index([memeId, type])
  @@index([userId])
  @@map("meme_reaction")
}
