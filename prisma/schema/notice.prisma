// ==============================
// GLOBAL NOTICEBOARD & EVENTS
// ==============================

model Notice {
  id                String   @id @default(uuid())
  referenceNo       String?
  title             String
  body              String
  issuerName        String
  issuerDesignation String
  copyTo            String[]

  issueDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([issueDate])
}

model CampusEvent {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("GENERAL")
  description String?
  location    String   @default("Permanent Campus")
  organizer   String?
  eventDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interested EventInterested[]

  @@index([eventDate])
  @@index([createdAt])
  @@index([category])
}

model EventInterested {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_interested")
}

