// ==============================
// MARKETPLACE ENUMS
// ==============================

enum ListingType {
  SELLING
  BUYING
}

enum ListingStatus {
  ACTIVE
  SOLD
  CLOSED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum MarketplaceCategory {
  TEXTBOOKS
  ELECTRONICS
  CALCULATORS
  COMPUTERS_ACCESSORIES
  LAB_DRAWING_TOOLS
  STATIONERY
  CYCLES_VEHICLES
  ROOM_HOSTEL_ESSENTIALS
  FURNITURE
  SPORTS_FITNESS
  CLOTHING
  MOBILE_ACCESSORIES
  OTHER
}

// ==============================
// CAMPUS MARKETPLACE (BUY & SELL)
// ==============================

model MarketplacePost {
  id                   String              @id @default(uuid())
  authorId             String
  type                 ListingType
  title                String
  description          String
  price                Float?              @default(0)
  category             MarketplaceCategory
  condition            ItemCondition?
  status               ListingStatus       @default(ACTIVE)
  images               String[]            @default([])
  contactPhone         String?
  isHiddenByModeration Boolean             @default(false)
  hiddenAt             DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  author   User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments MarketplaceComment[]

  @@index([authorId])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([status, type])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([type, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([category, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([isHiddenByModeration, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("marketplace_post")
}

model MarketplaceComment {
  id                   String    @id @default(uuid())
  postId               String
  authorId             String
  parentId             String?
  content              String
  isHiddenByModeration Boolean   @default(false)
  hiddenAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  post    MarketplacePost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  MarketplaceComment?  @relation("MarketplaceCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies MarketplaceComment[] @relation("MarketplaceCommentReplies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([postId, isHiddenByModeration, parentId, createdAt])
  @@map("marketplace_comment")
}
