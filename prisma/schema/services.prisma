// ==============================
// CAMPUS SERVICES ENUMS
// ==============================

enum ComplaintStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==============================
// COMPLAINTS MANAGEMENT
// ==============================

model Complaint {
  id           String          @id @default(uuid())
  userId       String
  title        String
  description  String
  category     String
  status       ComplaintStatus @default(PENDING)
  isAnonymous  Boolean         @default(false)
  adminRemarks String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==============================
// FIELD BOOKING
// ==============================

model FieldBooking {
  id          String        @id @default(uuid())
  userId      String
  purpose     String
  bookingDate DateTime
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, bookingDate])
}

model FieldSetting {
  id            String   @id @default(uuid())
  isBookingOpen Boolean  @default(true)
  closedNotice  String?
  updatedAt     DateTime @updatedAt
}

// ==============================
// BUS TRANSPORTATION
// ==============================

model BusSchedule {
  id            String   @id @default(uuid())
  route         String
  busNumber     String
  departureTime String
  stops         String[]
  createdAt     DateTime @default(now())
}

// ==============================
// ALUMNI DIRECTORY
// ==============================

model Alumni {
  id                 String   @id @default(uuid())
  name               String
  email              String?
  batch              String
  graduationYear     Int
  department         String
  degree             String?
  currentCompany     String?
  currentPosition    String?
  skills             String[]
  linkedInUrl        String?
  personalWebsiteUrl String?
  image              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
